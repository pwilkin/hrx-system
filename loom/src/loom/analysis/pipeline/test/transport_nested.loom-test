// ====
// RUN: emit pipeline-transport @stream

// Equal-count sibling loops preserve distinct scopes and execution order.
func.def @worker(%source: channel<tile<4xi32>>, %panels: channel<tile<4xi32>>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %replays = index.constant 4 : index
  %read, %payload = channel.acquire %source : channel<tile<4xi32>> -> (read<tile<4xi32>>, view<4xi32>)
  cfg.br ^panel_header(%begin: index)
^panel_header(%panel: index):
  %more_panels = index.cmp ult, %panel, %replays : index
  cfg.cond_br %more_panels, ^transfer, ^begin_second
^transfer:
  %write, %destination = channel.reserve %panels : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  %copy = kernel.async.copy %payload to %destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4xi32> to view<4xi32> -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  channel.publish %write : write<tile<4xi32>>
  %next_panel = index.add %panel, %step : index
  cfg.br ^panel_header(%next_panel: index)
^begin_second:
  cfg.br ^second_header(%begin: index)
^second_header(%second_panel: index):
  %more_second = index.cmp ult, %second_panel, %replays : index
  cfg.cond_br %more_second, ^second_transfer, ^release
^second_transfer:
  %second_write, %second_destination = channel.reserve %panels : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  %second_copy = kernel.async.copy %payload to %second_destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4xi32> to view<4xi32> -> kernel.async.token
  %second_group = kernel.async.group %second_copy : kernel.async.token -> kernel.async.group
  kernel.async.wait %second_group {newer_groups = 0} : kernel.async.group
  channel.publish %second_write : write<tile<4xi32>>
  %next_second = index.add %second_panel, %step : index
  cfg.br ^second_header(%next_second: index)
^release:
  channel.release %read : read<tile<4xi32>>
  func.return
}

pipeline.def<kernel> public @stream() run(%external_arg: buffer, %local_arg: buffer) {
  %external_unique, %local_unique = buffer.assume.noalias %external_arg, %local_arg : buffer, buffer
  %external = buffer.assume.memory_space<global> %external_unique : buffer
  %local = buffer.assume.memory_space<workgroup> %local_unique : buffer
  %origin = index.constant 0 : offset
  %capacity = index.constant 2 : index
  %source_slots = buffer.view %external[%origin] : buffer -> view<2x4xi32>
  %source = channel.bind<fifo> %source_slots, %capacity : view<2x4xi32>, index -> channel<tile<4xi32>>
  %panel_slots = buffer.view %local[%origin] : buffer -> view<2x4xi32>
  %panels = channel.bind<fifo> %panel_slots, %capacity : view<2x4xi32>, index -> channel<tile<4xi32>>
  pipeline.strand workers([0], [1], [1]) {
    func.call @worker(%source, %panels) : (channel<tile<4xi32>>, channel<tile<4xi32>>)
  }
}

