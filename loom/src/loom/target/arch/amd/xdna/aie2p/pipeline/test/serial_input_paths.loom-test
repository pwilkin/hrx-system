// RUN: emit source-low @entry target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// Three serial child occurrences reuse one physical input path. Each child has
// its own channels and descriptor geometry; the preceding child retires every
// queue before the next publishes its receivers. The varying bulk sizes must
// remain distinct while the source and receiver task registers stay shared.
// Four-value records shrink to two values and then return to four, exercising
// length/address replacement as well as the private ring iterator.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

func.def inline @fill(%width: index, %input: buffer, %base: offset, %channel: channel<tile<[%width]xi32>>, %count: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %value_bytes = index.constant 4 : offset
  %bytes = index.scale %width, %value_bytes : index, offset -> offset
  scf.for %record = [%begin to %count step %step] {
    %relative = index.scale %record, %bytes : index, offset -> offset
    %offset = index.add %base, %relative : offset
    %external = buffer.view %input[%offset] : buffer -> view<[%width]xi32>
    %write, %payload = channel.reserve %channel : channel<tile<[%width]xi32>> -> (write<tile<[%width]xi32>>, view<[%width]xi32>)
    %copy = kernel.async.copy %external to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<[%width]xi32> to view<[%width]xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<[%width]xi32>>
  }
  func.return
}

func.def inline @drain(%width: index, %channel: channel<tile<[%width]xi32>>, %output: buffer, %base: offset, %count: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %value_bytes = index.constant 4 : offset
  %bytes = index.scale %width, %value_bytes : index, offset -> offset
  %increment = scalar.constant 1 : i32
  scf.for %record = [%begin to %count step %step] {
    %read, %payload = channel.acquire<mutable> %channel : channel<tile<[%width]xi32>> -> (read<tile<[%width]xi32>, mutable>, view<[%width]xi32>)
    %value = view.load %payload[0] : view<[%width]xi32> -> i32
    %adjusted = scalar.addi %value, %increment : i32
    view.store %adjusted, %payload[0] : i32, view<[%width]xi32>
    %relative = index.scale %record, %bytes : index, offset -> offset
    %offset = index.add %base, %relative : offset
    %external = buffer.view %output[%offset] : buffer -> view<[%width]xi32>
    %copy = kernel.async.copy %payload to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<[%width]xi32> to view<[%width]xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<[%width]xi32>, mutable>
  }
  func.return
}

pipeline.def @phase(%width: index) run(%input: buffer, %output: buffer, %base: offset, %bulk_count: index) {
  %prefix_count = index.constant 1 : index
  %capacity = index.constant 2 : index
  %origin = index.constant 0 : offset
  %slot_bytes = index.constant 8 : offset
  %bytes = index.scale %width, %slot_bytes : index, offset -> offset
  %value_bytes = index.constant 4 : offset
  %source_bulk = index.scale %width, %value_bytes : index, offset -> offset
  %output_bulk = index.add %base, %source_bulk : offset
  %core = pipeline.memory<workgroup>[0, 2] : pool
  %prefix_storage = buffer.alloca<workgroup> pool(%core) align(4) %bytes : buffer
  %prefix_slots = buffer.view %prefix_storage[%origin] : buffer -> view<2x[%width]xi32>
  %prefix = channel.bind<fifo> %prefix_slots, %capacity : view<2x[%width]xi32>, index -> channel<tile<[%width]xi32>>
  %bulk_storage = buffer.alloca<workgroup> pool(%core) align(4) %bytes : buffer
  %bulk_slots = buffer.view %bulk_storage[%origin] : buffer -> view<2x[%width]xi32>
  %bulk = channel.bind<fifo> %bulk_slots, %capacity : view<2x[%width]xi32>, index -> channel<tile<[%width]xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @fill(%width, %input, %origin, %prefix, %prefix_count) : (index, buffer, offset, channel<tile<[%width]xi32>>, index)
    func.call @fill(%width, %input, %source_bulk, %bulk, %bulk_count) : (index, buffer, offset, channel<tile<[%width]xi32>>, index)
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @drain(%width, %prefix, %output, %base, %prefix_count) : (index, channel<tile<[%width]xi32>>, buffer, offset, index)
    func.call @drain(%width, %bulk, %output, %output_bulk, %bulk_count) : (index, channel<tile<[%width]xi32>>, buffer, offset, index)
  }
}

pipeline.def<kernel> public retain target(@device) @entry() run(%input_arg: buffer, %output_arg: buffer) {
  %input_unique, %output_unique = buffer.assume.noalias %input_arg, %output_arg : buffer, buffer
  %input, %output = buffer.assume.alignment %input_unique, %output_unique {minimum_alignment = 4} : buffer, buffer
  %origin = index.constant 0 : offset
  %second_base = index.constant 64 : offset
  %third_base = index.constant 80 : offset
  %first_count = index.constant 3 : index
  %second_count = index.constant 1 : index
  %third_count = index.constant 2 : index
  %full_width = index.constant 4 : index
  %tail_width = index.constant 2 : index
  pipeline.serial {
    pipeline.compose @phase[%full_width](%input, %output, %origin, %first_count) : [index](buffer, buffer, offset, index)
    pipeline.compose @phase[%tail_width](%input, %output, %second_base, %second_count) : [index](buffer, buffer, offset, index)
    pipeline.compose @phase[%full_width](%input, %output, %third_base, %third_count) : [index](buffer, buffer, offset, index)
  }
}

