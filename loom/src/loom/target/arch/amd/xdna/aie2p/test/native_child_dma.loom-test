// RUN: emit source-low @ordered_transfers target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// Three child calls use one core's ingress and egress engines. Every copy
// completes before the next child borrows its descriptors; different source
// addresses still select the same physical paths and completion resources.
// Dynamic copies share one relocated base per caller buffer, initialized once;
// every issue still adds its own complete offset to that immutable base.
// Repeated issues call the same native submission body with their own offset,
// relocation address, descriptor command, and task word.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def @copy_record() run(%records: channel<tile<1xi32>>, %input: buffer, %output: buffer, %offset: offset) {
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %write, %destination = channel.reserve %records : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %input_view = buffer.view %input[%offset] : buffer -> view<1xi32>
    %incoming = kernel.async.copy %input_view to %destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
    %arrival = kernel.async.group %incoming : kernel.async.token -> kernel.async.group
    kernel.async.wait %arrival {newer_groups = 0} : kernel.async.group
    %value = view.load %destination[0] : view<1xi32> -> i32
    %increment = scalar.constant 1 : i32
    %incremented = scalar.addi %value, %increment : i32
    view.store %incremented, %destination[0] : i32, view<1xi32>
    channel.publish %write : write<tile<1xi32>>
    %read, %source = channel.acquire %records : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
    %output_view = buffer.view %output[%offset] : buffer -> view<1xi32>
    %outgoing = kernel.async.copy %source to %output_view {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
    %departure = kernel.async.group %outgoing : kernel.async.token -> kernel.async.group
    kernel.async.wait %departure {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<1xi32>>
  }
}

pipeline.def<kernel> public retain target(@device) @ordered_transfers() run(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 4} : buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %last = index.constant 8 : offset
  %capacity = index.constant 1 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x1xi32>
  %records = channel.bind<fifo> %slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  pipeline.serial {
    pipeline.compose @copy_record(%records, %input, %output, %origin) : (channel<tile<1xi32>>, buffer, buffer, offset)
    pipeline.compose @copy_record(%records, %input, %output, %bytes) : (channel<tile<1xi32>>, buffer, buffer, offset)
    pipeline.compose @copy_record(%records, %input, %output, %last) : (channel<tile<1xi32>>, buffer, buffer, offset)
  }
}

