// =====
// RUN: emit source-low @entry target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// A core performs arithmetic while also archiving an input in private SRAM.
// The archive has no reader. Its exact residual uses the remote lock protocol
// after DMA completion, without clearing or copying either payload.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def @epoch() run(%input: buffer, %output: buffer, %epoch: index) {
  %capacity = index.constant 1 : index
  %origin = index.constant 0 : offset
  %record_bytes = index.constant 64 : offset
  %sram = pipeline.memory<workgroup>[0, 1] : pool
  %archive_storage = buffer.alloca<workgroup> pool(%sram) align(64) %record_bytes : buffer
  %archive_slots = buffer.view %archive_storage[%origin] : buffer -> view<1x16xi32>
  %archive = channel.bind<fifo> %archive_slots, %capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  %core = pipeline.memory<workgroup>[0, 2] : pool
  %result_storage = buffer.alloca<workgroup> pool(%core) align(64) %record_bytes : buffer
  %result_slots = buffer.view %result_storage[%origin] : buffer -> view<1x16xi32>
  %results = channel.bind<fifo> %result_slots, %capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %offset = index.scale %epoch, %record_bytes : index, offset -> offset
    %external = buffer.view %input[%offset] : buffer -> view<16xi32>
    %archive_write, %archive_payload = channel.reserve %archive : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    %ingress = kernel.async.copy %external to %archive_payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xi32> to view<16xi32> -> kernel.async.token
    %write, %payload = channel.reserve %results : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    %value = index.cast %epoch : index to i32
    %values = vector.splat %value : vector<16xi32>
    vector.store %values, %payload[0] : vector<16xi32>, view<16xi32>
    channel.publish %write : write<tile<16xi32>>
    %read, %ready = channel.acquire %results : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    %destination = buffer.view %output[%offset] : buffer -> view<16xi32>
    %egress = kernel.async.copy %ready to %destination {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi32> to view<16xi32> -> kernel.async.token
    %output_group = kernel.async.group %ingress, %egress : kernel.async.token, kernel.async.token -> kernel.async.group
    kernel.async.wait %output_group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<16xi32>>
    channel.publish %archive_write : write<tile<16xi32>>
  }
}

pipeline.def<kernel> public retain target(@device) @entry() run(%input_arg: buffer, %output_arg: buffer) {
  %input_unique, %output_unique = buffer.assume.noalias %input_arg, %output_arg : buffer, buffer
  %input, %output = buffer.assume.alignment %input_unique, %output_unique {minimum_alignment = 64} : buffer, buffer
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %epochs = index.constant 2 : index
  pipeline.serial {
    scf.for %epoch = [%begin to %epochs step %step] {
      pipeline.compose @epoch(%input, %output, %epoch) : (buffer, buffer, index)
    }
  }
}

