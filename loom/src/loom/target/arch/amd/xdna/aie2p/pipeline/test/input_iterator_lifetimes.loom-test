// RUN: emit source-low @entry target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// Two prefix records advance a three-slot receiver on each child visit.
// Child construction restarts it at slot zero. The bulk also ends a partial
// turn after several bounded DMA windows.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

func.def inline @fill(%input: buffer, %base: offset, %channel: channel<tile<1xi32>>, %count: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %bytes = index.constant 4 : offset
  scf.for %record = [%begin to %count step %step] {
    %relative = index.scale %record, %bytes : index, offset -> offset
    %offset = index.add %base, %relative : offset
    %external = buffer.view %input[%offset] : buffer -> view<1xi32>
    %write, %payload = channel.reserve %channel : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %copy = kernel.async.copy %external to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<1xi32>>
  }
  func.return
}

func.def inline @drain(%channel: channel<tile<1xi32>>, %output: buffer, %base: offset, %count: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %bytes = index.constant 4 : offset
  %increment = scalar.constant 1 : i32
  scf.for %record = [%begin to %count step %step] {
    %read, %payload = channel.acquire<mutable> %channel : channel<tile<1xi32>> -> (read<tile<1xi32>, mutable>, view<1xi32>)
    %value = view.load %payload[0] : view<1xi32> -> i32
    %adjusted = scalar.addi %value, %increment : i32
    view.store %adjusted, %payload[0] : i32, view<1xi32>
    %relative = index.scale %record, %bytes : index, offset -> offset
    %offset = index.add %base, %relative : offset
    %external = buffer.view %output[%offset] : buffer -> view<1xi32>
    %copy = kernel.async.copy %payload to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<1xi32>, mutable>
  }
  func.return
}

pipeline.def @phase() run(%input: buffer, %output: buffer, %base: offset) {
  %capacity = index.constant 3 : index
  %origin = index.constant 0 : offset
  %prefix_bytes = index.constant 12 : offset
  %bulk_bytes = index.constant 12 : offset
  %core = pipeline.memory<workgroup>[0, 2] : pool
  %prefix_storage = buffer.alloca<workgroup> pool(%core) align(4) %prefix_bytes : buffer
  %prefix_slots = buffer.view %prefix_storage[%origin] : buffer -> view<3x1xi32>
  %prefix = channel.bind<fifo> %prefix_slots, %capacity : view<3x1xi32>, index -> channel<tile<1xi32>>
  %bulk_storage = buffer.alloca<workgroup> pool(%core) align(4) %bulk_bytes : buffer
  %bulk_slots = buffer.view %bulk_storage[%origin] : buffer -> view<3x1xi32>
  %bulk = channel.bind<fifo> %bulk_slots, %capacity : view<3x1xi32>, index -> channel<tile<1xi32>>
  %prefix_count = index.constant 2 : index
  %bulk_count = index.constant 1025 : index
  %source_begin = index.constant 0 : offset
  %source_bulk = index.constant 8 : offset
  %output_bulk = index.add %base, %source_bulk : offset
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @fill(%input, %source_begin, %prefix, %prefix_count) : (buffer, offset, channel<tile<1xi32>>, index)
    func.call @fill(%input, %source_bulk, %bulk, %bulk_count) : (buffer, offset, channel<tile<1xi32>>, index)
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @drain(%prefix, %output, %base, %prefix_count) : (channel<tile<1xi32>>, buffer, offset, index)
    func.call @drain(%bulk, %output, %output_bulk, %bulk_count) : (channel<tile<1xi32>>, buffer, offset, index)
  }
}

pipeline.def<kernel> public retain target(@device) @entry() run(%input_arg: buffer, %output_arg: buffer) {
  %input_unique, %output_unique = buffer.assume.noalias %input_arg, %output_arg : buffer, buffer
  %input, %output = buffer.assume.alignment %input_unique, %output_unique {minimum_alignment = 4} : buffer, buffer
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %visits = index.constant 3 : index
  %output_bytes = index.constant 4108 : offset
  pipeline.serial {
    scf.for %visit = [%begin to %visits step %step] {
      %base = index.scale %visit, %output_bytes : index, offset -> offset
      pipeline.compose @phase(%input, %output, %base) : (buffer, buffer, offset)
    }
  }
}

