// RUN: emit source-low @scatter target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// Twenty fixed singleton copies exceed each endpoint's sixteen descriptors.
// The final two-segment task must be admitted before spare slots are assigned
// to fixed addresses. Remaining singletons keep issue-time patching, while a
// repeated address reuses its fixed variant even after the bank is full.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @scatter() run(%output_arg: buffer) {
  %output = buffer.assume.alignment %output_arg {minimum_alignment = 4} : buffer
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %origin = index.constant 0 : offset
  %bytes = index.constant 128 : offset
  %capacity = index.constant 1 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x32xi32>
  %channel = channel.bind<fifo> %slots, %capacity : view<1x32xi32>, index -> channel<tile<32xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %write, %destination = channel.reserve %channel : channel<tile<32xi32>> -> (write<tile<32xi32>>, view<32xi32>)
    %values = vector.splati 17 : vector<32xi32>
    vector.store %values, %destination[0] : vector<32xi32>, view<32xi32>
    channel.publish %write : write<tile<32xi32>>
    %read, %source = channel.acquire %channel : channel<tile<32xi32>> -> (read<tile<32xi32>>, view<32xi32>)
    %begin = index.constant 0 : index
    %end = index.constant 20 : index
    %step = index.constant 1 : index
    %word_bytes = index.constant 4 : offset
    scf.for %position = [%begin to %end step %step] unroll {
      %part = view.subview %source[%position] : view<32xi32> -> view<1xi32>
      %offset = index.scale %position, %word_bytes : index, offset -> offset
      %target = buffer.view %output[%offset] : buffer -> view<1xi32>
      %copy = kernel.async.copy %part to %target {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
      %completion = kernel.async.group %copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %completion {newer_groups = 0} : kernel.async.group
    }
    %last = index.constant 21 : index
    %left = view.subview %source[%end] : view<32xi32> -> view<1xi32>
    %right = view.subview %source[%last] : view<32xi32> -> view<1xi32>
    %left_offset = index.scale %end, %word_bytes : index, offset -> offset
    %right_offset = index.scale %last, %word_bytes : index, offset -> offset
    %left_target = buffer.view %output[%left_offset] : buffer -> view<1xi32>
    %right_target = buffer.view %output[%right_offset] : buffer -> view<1xi32>
    %left_copy = kernel.async.copy %left to %left_target {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
    %right_copy = kernel.async.copy %right to %right_target {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
    %pair = kernel.async.group %left_copy, %right_copy : kernel.async.token, kernel.async.token -> kernel.async.group
    kernel.async.wait %pair {newer_groups = 0} : kernel.async.group
    %repeat = view.subview %source[%step] : view<32xi32> -> view<1xi32>
    %repeat_target = buffer.view %output[%word_bytes] : buffer -> view<1xi32>
    %repeat_copy = kernel.async.copy %repeat to %repeat_target {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
    %repeat_completion = kernel.async.group %repeat_copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %repeat_completion {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<32xi32>>
  }
}

