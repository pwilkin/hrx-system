// RUN: emit source-low @entry target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// Two different child calls publish once each, followed by one read. The last
// writer's count equals the reader's count, but it is not the complete private
// lifetime. Restoration belongs to the owner after both imported writer calls.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def @produce() run(%channel: channel<tile<16xi32>>, %epoch: index) {
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %value = index.cast %epoch : index to i32
    %values = vector.splat %value : vector<16xi32>
    %write, %payload = channel.reserve %channel : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    vector.store %values, %payload[0] : vector<16xi32>, view<16xi32>
    channel.publish %write : write<tile<16xi32>>
  }
}

pipeline.def @consume() run(%channel: channel<tile<16xi32>>, %output: buffer, %epoch: index) {
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %record_bytes = index.constant 64 : offset
    %read, %payload = channel.acquire<mutable> %channel : channel<tile<16xi32>> -> (read<tile<16xi32>, mutable>, view<16xi32>)
    %value = index.cast %epoch : index to i32
    %biases = vector.splat %value : vector<16xi32>
    %values = vector.load %payload[0] : view<16xi32> -> vector<16xi32>
    %adjusted = vector.addi %values, %biases : vector<16xi32>
    vector.store %adjusted, %payload[0] : vector<16xi32>, view<16xi32>
    %offset = index.scale %epoch, %record_bytes : index, offset -> offset
    %destination = buffer.view %output[%offset] : buffer -> view<16xi32>
    %copy = kernel.async.copy %payload to %destination {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi32> to view<16xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<16xi32>, mutable>
  }
}

pipeline.def @epoch() run(%output: buffer, %epoch: index) {
  %capacity = index.constant 2 : index
  %origin = index.constant 0 : offset
  %storage_bytes = index.constant 128 : offset
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %storage = buffer.alloca<workgroup> pool(%memory) align(64) %storage_bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<2x16xi32>
  %channel = channel.bind<fifo> %slots, %capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  pipeline.serial {
    pipeline.compose @produce(%channel, %epoch) : (channel<tile<16xi32>>, index)
    pipeline.compose @produce(%channel, %epoch) : (channel<tile<16xi32>>, index)
    pipeline.compose @consume(%channel, %output, %epoch) : (channel<tile<16xi32>>, buffer, index)
  }
}

pipeline.def<kernel> public retain target(@device) @entry() run(%output_arg: buffer) {
  %output = buffer.assume.alignment %output_arg {minimum_alignment = 64} : buffer
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %epochs = index.constant 2 : index
  pipeline.serial {
    scf.for %epoch = [%begin to %epochs step %step] {
      pipeline.compose @epoch(%output, %epoch) : (buffer, index)
    }
  }
}

