// ====
// RUN: emit source-low @sram_input target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// The same ownership protocol admits reusable SRAM writes from a compute core.
// Ingress completes before publication, and DMA feeds the local arithmetic.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @sram_input() run(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 4} : buffer, buffer
  %origin = index.constant 0 : offset
  %storage_bytes = index.constant 128 : offset
  %record_bytes = index.constant 64 : offset
  %begin = index.constant 0 : index
  %capacity = index.constant 2 : index
  %end = index.constant 64 : index
  %step = index.constant 1 : index
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %sram = pipeline.memory<workgroup>[0, 1] : pool
  %local_storage = buffer.alloca<workgroup> pool(%memory) align(4) %storage_bytes : buffer
  %local_slots = buffer.view %local_storage[%origin] : buffer -> view<2x16xi32>
  %local = channel.bind<fifo> %local_slots, %capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  %result_storage = buffer.alloca<workgroup> pool(%sram) align(4) %storage_bytes : buffer
  %result_slots = buffer.view %result_storage[%origin] : buffer -> view<2x16xi32>
  %result = channel.bind<fifo> %result_slots, %capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %end step %step] {
      %offset = index.scale %record, %record_bytes : index, offset -> offset
      %external_input = buffer.view %input[%offset] : buffer -> view<16xi32>
      %external_output = buffer.view %output[%offset] : buffer -> view<16xi32>
      %write, %payload = channel.reserve %result : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
      %ingress = kernel.async.copy %external_input to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xi32> to view<16xi32> -> kernel.async.token
      %arrival = kernel.async.group %ingress : kernel.async.token -> kernel.async.group
      kernel.async.wait %arrival {newer_groups = 0} : kernel.async.group
      channel.publish %write : write<tile<16xi32>>
      %read, %ready = channel.acquire %local : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
      %value = view.load %ready[0] : view<16xi32> -> i32
      %increment = scalar.constant 37 : i32
      %updated = scalar.addi %value, %increment : i32
      view.store %updated, %ready[0] : i32, view<16xi32>
      %egress = kernel.async.copy %ready to %external_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi32> to view<16xi32> -> kernel.async.token
      %departure = kernel.async.group %egress : kernel.async.token -> kernel.async.group
      kernel.async.wait %departure {newer_groups = 0} : kernel.async.group
      channel.release %read : read<tile<16xi32>>
    }
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %end step %step] {
      %read, %source = channel.acquire %result : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
      %write, %destination = channel.reserve %local : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
      channel.copy %read -> %write : read<tile<16xi32>>, write<tile<16xi32>>
    }
  }
}

