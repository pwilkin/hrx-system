// RUN: emit source-low @entry target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// A runtime choice leaves either zero or one published private record. Both
// cores first retire the child, the controller restores and acknowledges the
// lock state, and both join again before either starts another lifetime.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def @conditional() run(%output: buffer, %epoch: index) {
  %capacity = index.constant 1 : index
  %origin = index.constant 0 : offset
  %record_bytes = index.constant 64 : offset
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %storage = buffer.alloca<workgroup> pool(%memory) align(64) %record_bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x16xi32>
  %channel = channel.bind<fifo> %slots, %capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  %peer_memory = pipeline.memory<workgroup>[0, 3] : pool
  %peer_storage = buffer.alloca<workgroup> pool(%peer_memory) align(64) %record_bytes : buffer
  %peer_slots = buffer.view %peer_storage[%origin] : buffer -> view<1x16xi32>
  %peer_channel = channel.bind<fifo> %peer_slots, %capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %begin = index.constant 0 : index
    %emit = index.cmp ne, %epoch, %begin : index
    scf.if %emit {
      %value = index.cast %epoch : index to i32
      %values = vector.splat %value : vector<16xi32>
      %write, %payload = channel.reserve %channel : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
      vector.store %values, %payload[0] : vector<16xi32>, view<16xi32>
      %offset = index.scale %epoch, %record_bytes : index, offset -> offset
      %destination = buffer.view %output[%offset] : buffer -> view<16xi32>
      %copy = kernel.async.copy %payload to %destination {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi32> to view<16xi32> -> kernel.async.token
      %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %group {newer_groups = 0} : kernel.async.group
      channel.publish %write : write<tile<16xi32>>
    }
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %value = scalar.constant 17 : i32
    %values = vector.splat %value : vector<16xi32>
    %write, %payload = channel.reserve %peer_channel : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    vector.store %values, %payload[0] : vector<16xi32>, view<16xi32>
    %peer_base = index.constant 192 : offset
    %relative = index.scale %epoch, %record_bytes : index, offset -> offset
    %offset = index.add %peer_base, %relative : offset
    %destination = buffer.view %output[%offset] : buffer -> view<16xi32>
    %copy = kernel.async.copy %payload to %destination {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi32> to view<16xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<16xi32>>
    %read, %completed = channel.acquire %peer_channel : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    channel.release %read : read<tile<16xi32>>
  }
}

pipeline.def<kernel> public retain target(@device) @entry() run(%output_arg: buffer) {
  %output = buffer.assume.alignment %output_arg {minimum_alignment = 64} : buffer
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %epochs = index.constant 3 : index
  pipeline.serial {
    scf.for %epoch = [%begin to %epochs step %step] {
      pipeline.compose @conditional(%output, %epoch) : (buffer, index)
    }
  }
}

