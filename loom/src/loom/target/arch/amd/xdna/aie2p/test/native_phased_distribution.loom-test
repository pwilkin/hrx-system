// RUN: emit source-low @phased_multicast target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=module

// Each cycle sends one coefficient and 2,880 panels to two receivers. The
// coefficient remains borrowed until its whole cycle completes. Its one-slot
// credit is distinct from the two-slot panel ring, although both use one DMA
// queue. Refills must submit the next coefficient before that cycle's panels.
// A 240-record window divides the cycle and the two-slot ring; the largest
// hardware window of 256 does not. Both endpoints retain one shared DMA queue.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

func.def inline @channels(%memory: pool) -> (channel<tile<1xi32>>, channel<tile<16xi32>>) {
  %origin = index.constant 0 : offset
  %panel_offset = index.constant 64 : offset
  %storage_bytes = index.constant 192 : offset
  %prefix_capacity = index.constant 1 : index
  %panel_capacity = index.constant 2 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(64) %storage_bytes : buffer
  %prefix_slots = buffer.view %storage[%origin] : buffer -> view<1x1xi32>
  %panel_slots = buffer.view %storage[%panel_offset] : buffer -> view<2x16xi32>
  %prefix = channel.bind<fifo> %prefix_slots, %prefix_capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  %bulk = channel.bind<fifo> %panel_slots, %panel_capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  func.return %prefix, %bulk : channel<tile<1xi32>>, channel<tile<16xi32>>
}

func.def inline @consume(%prefix: channel<tile<1xi32>>, %bulk: channel<tile<16xi32>>, %output: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %cycles = index.constant 2 : index
  %records = index.constant 2880 : index
  %record_bytes = index.constant 64 : offset
  scf.for %cycle = [%begin to %cycles step %step] {
    %prefix_read, %coefficient_view = channel.acquire %prefix : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
    %coefficient = view.load %coefficient_view[0] : view<1xi32> -> i32
    %bias = vector.splat %coefficient : vector<16xi32>
    scf.for %record = [%begin to %records step %step] {
      %read, %payload = channel.acquire<mutable> %bulk : channel<tile<16xi32>> -> (read<tile<16xi32>, mutable>, view<16xi32>)
      %values = vector.load %payload[0] : view<16xi32> -> vector<16xi32>
      %result = vector.addi %values, %bias : vector<16xi32>
      vector.store %result, %payload[0] : vector<16xi32>, view<16xi32>
      %position = index.madd %cycle, %records, %record : index
      %offset = index.scale %position, %record_bytes : index, offset -> offset
      %destination = buffer.view %output[%offset] : buffer -> view<16xi32>
      %copy = kernel.async.copy %payload to %destination {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi32> to view<16xi32> -> kernel.async.token
      %departure = kernel.async.group %copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %departure {newer_groups = 0} : kernel.async.group
      channel.release %read : read<tile<16xi32>, mutable>
    }
    channel.release %prefix_read : read<tile<1xi32>>
  }
  func.return
}

pipeline.def<kernel> public retain target(@device) @phased_multicast() run(%left_arg: buffer, %right_arg: buffer) {
  %left_unique, %right_unique = buffer.assume.noalias %left_arg, %right_arg : buffer, buffer
  %left, %right = buffer.assume.alignment %left_unique, %right_unique {minimum_alignment = 64} : buffer, buffer
  %source_memory = pipeline.memory<workgroup>[0, 4] : pool
  %left_memory = pipeline.memory<workgroup>[0, 2] : pool
  %right_memory = pipeline.memory<workgroup>[0, 3] : pool
  %source_prefix, %source_bulk = func.call @channels(%source_memory) : (pool) -> (channel<tile<1xi32>>, channel<tile<16xi32>>)
  %left_prefix, %left_bulk = func.call @channels(%left_memory) : (pool) -> (channel<tile<1xi32>>, channel<tile<16xi32>>)
  %right_prefix, %right_bulk = func.call @channels(%right_memory) : (pool) -> (channel<tile<1xi32>>, channel<tile<16xi32>>)
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %cycles = index.constant 2 : index
  %records = index.constant 2880 : index
  pipeline.strand workers([0, 4], [1, 1], [1, 1]) {
    scf.for %cycle = [%begin to %cycles step %step] {
      %write, %payload = channel.reserve %source_prefix : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
      %coefficient = index.cast %cycle : index to i32
      view.store %coefficient, %payload[0] : i32, view<1xi32>
      channel.publish %write : write<tile<1xi32>>
      scf.for %record = [%begin to %records step %step] {
        %write, %payload = channel.reserve %source_bulk : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
        %value = index.cast %record : index to i32
        %values = vector.splat %value : vector<16xi32>
        vector.store %values, %payload[0] : vector<16xi32>, view<16xi32>
        channel.publish %write : write<tile<16xi32>>
      }
    }
  }
  pipeline.strand workers([0, 4], [1, 1], [1, 1]) {
    scf.for %cycle = [%begin to %cycles step %step] {
      %read, %payload = channel.acquire %source_prefix : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
      %first_read, %second_read = channel.fanout %read : read<tile<1xi32>> -> (read<tile<1xi32>>, read<tile<1xi32>>)
      %first_write, %first_payload = channel.reserve %left_prefix : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
      %second_write, %second_payload = channel.reserve %right_prefix : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
      channel.copy %first_read -> %first_write : read<tile<1xi32>>, write<tile<1xi32>>
      channel.copy %second_read -> %second_write : read<tile<1xi32>>, write<tile<1xi32>>
      scf.for %record = [%begin to %records step %step] {
        %read, %payload = channel.acquire %source_bulk : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
        %first_read, %second_read = channel.fanout %read : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
        %first_write, %first_payload = channel.reserve %left_bulk : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
        %second_write, %second_payload = channel.reserve %right_bulk : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
        channel.copy %first_read -> %first_write : read<tile<16xi32>>, write<tile<16xi32>>
        channel.copy %second_read -> %second_write : read<tile<16xi32>>, write<tile<16xi32>>
      }
    }
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @consume(%left_prefix, %left_bulk, %left) : (channel<tile<1xi32>>, channel<tile<16xi32>>, buffer)
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    func.call @consume(%right_prefix, %right_bulk, %right) : (channel<tile<1xi32>>, channel<tile<16xi32>>, buffer)
  }
}

