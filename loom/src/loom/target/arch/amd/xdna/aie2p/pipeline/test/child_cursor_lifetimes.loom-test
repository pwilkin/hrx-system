// RUN: emit source-low @entry target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// The same nested calls import the root's ring. It must continue across owner
// visits, yielding positions 0,1,2,0 instead of restarting at each child entry.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def @write_record() run(%channel: channel<tile<1xi32>>, %storage: buffer, %outgoing: channel<tile<3xi32>>, %output: buffer, %phase: index) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 12 : offset
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %contents = buffer.view %storage[%origin] : buffer -> view<3xi32>
    %sentinel = scalar.constant -9999 : i32
    view.store %sentinel, %contents[0] : i32, view<3xi32>
    view.store %sentinel, %contents[1] : i32, view<3xi32>
    view.store %sentinel, %contents[2] : i32, view<3xi32>
    %write, %destination = channel.reserve %channel : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %value = index.cast %phase : index to i32
    view.store %value, %destination[0] : i32, view<1xi32>
    channel.publish %write : write<tile<1xi32>>
    %read, %source = channel.acquire %channel : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
    channel.release %read : read<tile<1xi32>>
    %first = view.load %contents[0] : view<3xi32> -> i32
    %second = view.load %contents[1] : view<3xi32> -> i32
    %third = view.load %contents[2] : view<3xi32> -> i32
    %write_result, %result = channel.reserve %outgoing : channel<tile<3xi32>> -> (write<tile<3xi32>>, view<3xi32>)
    view.store %first, %result[0] : i32, view<3xi32>
    view.store %second, %result[1] : i32, view<3xi32>
    view.store %third, %result[2] : i32, view<3xi32>
    channel.publish %write_result : write<tile<3xi32>>
    %read_result, %payload = channel.acquire %outgoing : channel<tile<3xi32>> -> (read<tile<3xi32>>, view<3xi32>)
    %offset = index.scale %phase, %bytes : index, offset -> offset
    %external = buffer.view %output[%offset] : buffer -> view<3xi32>
    %copy = kernel.async.copy %payload to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<3xi32> to view<3xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.release %read_result : read<tile<3xi32>>
  }
}

pipeline.def @owner() run(%channel: channel<tile<1xi32>>, %storage: buffer, %outgoing: channel<tile<3xi32>>, %output: buffer, %visit: index) {
  %c1 = index.constant 1 : index
  %pair_width = index.constant 2 : index
  %first_phase = index.mul %visit, %pair_width : index
  %second_phase = index.add %first_phase, %c1 : index
  pipeline.serial {
    pipeline.compose @write_record(%channel, %storage, %outgoing, %output, %first_phase) : (channel<tile<1xi32>>, buffer, channel<tile<3xi32>>, buffer, index)
    pipeline.compose @write_record(%channel, %storage, %outgoing, %output, %second_phase) : (channel<tile<1xi32>>, buffer, channel<tile<3xi32>>, buffer, index)
  }
}

pipeline.def<kernel> public retain target(@device) @entry() run(%output_argument: buffer) {
  %output = buffer.assume.alignment %output_argument {minimum_alignment = 4} : buffer
  %origin = index.constant 0 : offset
  %bytes = index.constant 12 : offset
  %capacity = index.constant 3 : index
  %c1 = index.constant 1 : index
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<3x1xi32>
  %channel = channel.bind<fifo> %slots, %capacity : view<3x1xi32>, index -> channel<tile<1xi32>>
  %outgoing_storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %outgoing_slots = buffer.view %outgoing_storage[%origin] : buffer -> view<1x3xi32>
  %outgoing = channel.bind<fifo> %outgoing_slots, %c1 : view<1x3xi32>, index -> channel<tile<3xi32>>
  %begin = index.constant 0 : index
  %count = index.constant 2 : index
  %step = index.constant 1 : index
  pipeline.serial {
    scf.for %visit = [%begin to %count step %step] {
      pipeline.compose @owner(%channel, %storage, %outgoing, %output, %visit) : (channel<tile<1xi32>>, buffer, channel<tile<3xi32>>, buffer, index)
    }
  }
}

