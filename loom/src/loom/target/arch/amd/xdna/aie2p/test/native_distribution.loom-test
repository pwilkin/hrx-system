// ====

// RUN: emit source-low output=low

aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

// Select the same-tile distribution pair before the unconstrained ingress.
// Loopback keeps matching MM2S0/S2MM0; ingress uses the second receiver.
pipeline.def<kernel> public retain target(@device) @ingress_and_distribution_loopback() run(%input_arg: buffer) {
  %input = buffer.assume.alignment %input_arg {minimum_alignment = 64} : buffer
  %source_memory = pipeline.memory<workgroup>[0, 2] : pool
  %destination_memory = pipeline.memory<workgroup>[0, 2] : pool
  %bytes = index.constant 64 : offset
  %origin = index.constant 0 : offset
  %capacity = index.constant 1 : index
  %source_storage = buffer.alloca<workgroup> pool(%source_memory) align(64) %bytes : buffer
  %source_slots = buffer.view %source_storage[%origin] : buffer -> view<1x16xi32>
  %source = channel.bind<fifo> %source_slots, %capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  %destination_storage = buffer.alloca<workgroup> pool(%destination_memory) align(64) %bytes : buffer
  %destination_slots = buffer.view %destination_storage[%origin] : buffer -> view<1x16xi32>
  %destination = channel.bind<fifo> %destination_slots, %capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external = buffer.view %input[%origin] : buffer -> view<16xi32>
    %write, %payload = channel.reserve %source : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    %copy = kernel.async.copy %external to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xi32> to view<16xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<16xi32>>
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %read, %payload = channel.acquire %source : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    %write, %destination_payload = channel.reserve %destination : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    channel.copy %read -> %write : read<tile<16xi32>>, write<tile<16xi32>>
  }
}

