// RUN: emit source-low @staged_records target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// A core fills a retained SRAM batch through borrowed DMA views, then consumes
// its replay through compute memory. SRAM payloads have no core address. Each
// copy retires both endpoint tasks before the complete batch is published.
// Fixed byte addresses encode as word-address constants in the DMA packets;
// advancing the destination by four bytes advances that encoded address by one.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @staged_records() run(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 4} : buffer, buffer
  %origin = index.constant 0 : offset
  %bytes = index.constant 16 : offset
  %stride = index.constant 8 : offset
  %begin = index.constant 0 : index
  %capacity = index.constant 2 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %sram = pipeline.memory<workgroup>[0, 1] : pool
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %retained_storage = buffer.alloca<workgroup> pool(%sram) align(4) %bytes : buffer
  %retained_slots = buffer.view %retained_storage[%origin] : buffer -> view<2x2xi32>
  %retained = channel.bind<fifo> %retained_slots, %capacity : view<2x2xi32>, index -> channel<tile<2xi32>>
  %local_storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %local_slots = buffer.view %local_storage[%origin] : buffer -> view<2x2xi32>
  %local = channel.bind<fifo> %local_slots, %capacity : view<2x2xi32>, index -> channel<tile<2xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %capacity step %step] unroll {
      %offset = index.scale %record, %stride : index, offset -> offset
      %external = buffer.view %input[%offset] : buffer -> view<2xi32>
      %write, %payload = channel.reserve %retained : channel<tile<2xi32>> -> (write<tile<2xi32>>, view<2xi32>)
      %source_left = view.subview %external[0] : view<2xi32> -> view<1xi32>
      %source_right = view.subview %external[1] : view<2xi32> -> view<1xi32>
      %destination_left = view.subview %payload[0] : view<2xi32> -> view<1xi32>
      %destination_right = view.subview %payload[1] : view<2xi32> -> view<1xi32>
      %left = kernel.async.copy %source_left to %destination_left {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
      %left_arrival = kernel.async.group %left : kernel.async.token -> kernel.async.group
      kernel.async.wait %left_arrival {newer_groups = 0} : kernel.async.group
      %right = kernel.async.copy %source_right to %destination_right {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
      %arrival = kernel.async.group %right : kernel.async.token -> kernel.async.group
      kernel.async.wait %arrival {newer_groups = 0} : kernel.async.group
      channel.publish %write : write<tile<2xi32>>
    }
    scf.for %record = [%begin to %end step %step] {
      %read, %payload = channel.acquire %local : channel<tile<2xi32>> -> (read<tile<2xi32>>, view<2xi32>)
      %value = view.load %payload[0] : view<2xi32> -> i32
      %increment = scalar.constant 1 : i32
      %result = scalar.addi %value, %increment : i32
      view.store %result, %payload[0] : i32, view<2xi32>
      %offset = index.scale %record, %stride : index, offset -> offset
      %external = buffer.view %output[%offset] : buffer -> view<2xi32>
      %copy = kernel.async.copy %payload to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<2xi32> to view<2xi32> -> kernel.async.token
      %departure = kernel.async.group %copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %departure {newer_groups = 0} : kernel.async.group
      channel.release %read : read<tile<2xi32>>
    }
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %first, %first_payload = channel.acquire %retained : channel<tile<2xi32>> -> (read<tile<2xi32>>, view<2xi32>)
    %second, %second_payload = channel.acquire %retained : channel<tile<2xi32>> -> (read<tile<2xi32>>, view<2xi32>)
    %first_last, %second_last = scf.for %replay = [%begin to %capacity step %step](%first_read = %first : read<tile<2xi32>>, %second_read = %second : read<tile<2xi32>>) -> (read<tile<2xi32>>, read<tile<2xi32>>) {
      %first_copy, %first_keep = channel.fanout %first_read : read<tile<2xi32>> -> (read<tile<2xi32>>, read<tile<2xi32>>)
      %first_write, %first_destination = channel.reserve %local : channel<tile<2xi32>> -> (write<tile<2xi32>>, view<2xi32>)
      channel.copy %first_copy -> %first_write : read<tile<2xi32>>, write<tile<2xi32>>
      %second_copy, %second_keep = channel.fanout %second_read : read<tile<2xi32>> -> (read<tile<2xi32>>, read<tile<2xi32>>)
      %second_write, %second_destination = channel.reserve %local : channel<tile<2xi32>> -> (write<tile<2xi32>>, view<2xi32>)
      channel.copy %second_copy -> %second_write : read<tile<2xi32>>, write<tile<2xi32>>
      scf.yield %first_keep, %second_keep : read<tile<2xi32>>, read<tile<2xi32>>
    }
    channel.release %first_last : read<tile<2xi32>>
    channel.release %second_last : read<tile<2xi32>>
  }
}

