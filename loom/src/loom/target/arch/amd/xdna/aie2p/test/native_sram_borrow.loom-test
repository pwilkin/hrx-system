// ====
// RUN: emit aie2p-xdna input=source-low

// A borrowed SRAM view can flow through DMA projections, but an ordinary
// compute load or store still requires a directly visible memory aperture.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @direct_sram_store() run(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 4} : buffer, buffer
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %capacity = index.constant 1 : index
  %sram = pipeline.memory<workgroup>[0, 1] : pool
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %storage = buffer.alloca<workgroup> pool(%sram) align(4) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x1xi32>
  %source = channel.bind<fifo> %slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  %local_storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %local_slots = buffer.view %local_storage[%origin] : buffer -> view<1x1xi32>
  %local = channel.bind<fifo> %local_slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    // ERROR@+1: XDNA/051 {requirement="SRAM payload borrows consumed exclusively by DMA"}
    %write, %payload = channel.reserve %source : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %external = buffer.view %input[%origin] : buffer -> view<1xi32>
    %copy = kernel.async.copy %external to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
    %arrival = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %arrival {newer_groups = 0} : kernel.async.group
    %replacement = scalar.constant 42 : i32
    view.store %replacement, %payload[0] : i32, view<1xi32>
    channel.publish %write : write<tile<1xi32>>
    %read, %result = channel.acquire %local : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
    %output_view = buffer.view %output[%origin] : buffer -> view<1xi32>
    %outgoing = kernel.async.copy %result to %output_view {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
    %departure = kernel.async.group %outgoing : kernel.async.token -> kernel.async.group
    kernel.async.wait %departure {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<1xi32>>
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %read, %payload = channel.acquire %source : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
    %keep, %copy = channel.fanout %read : read<tile<1xi32>> -> (read<tile<1xi32>>, read<tile<1xi32>>)
    %write, %destination = channel.reserve %local : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    channel.copy %copy -> %write : read<tile<1xi32>>, write<tile<1xi32>>
    channel.release %keep : read<tile<1xi32>>
  }
}

// ====
// RUN: emit aie2p-xdna input=source-low

// Independent task paths cannot share untagged core completion reads while
// different source waits are outstanding; the later task may complete first.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @overlapping_task_tokens() run(%input_arg: buffer, %output_arg: buffer) {
  %input_unique, %output_unique = buffer.assume.noalias %input_arg, %output_arg : buffer, buffer
  %input, %output = buffer.assume.alignment %input_unique, %output_unique {minimum_alignment = 4} : buffer, buffer
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %capacity = index.constant 1 : index
  %sram = pipeline.memory<workgroup>[0, 1] : pool
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %storage = buffer.alloca<workgroup> pool(%sram) align(4) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x1xi32>
  %source = channel.bind<fifo> %slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  %local_storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %local_slots = buffer.view %local_storage[%origin] : buffer -> view<1x1xi32>
  %local = channel.bind<fifo> %local_slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  %destination_storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %destination_slots = buffer.view %destination_storage[%origin] : buffer -> view<1x1xi32>
  %destination = channel.bind<fifo> %destination_slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %write, %payload = channel.reserve %source : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %external = buffer.view %input[%origin] : buffer -> view<1xi32>
    %copy = kernel.async.copy %external to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
    %arrival = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    %local_write, %local_payload = channel.reserve %local : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %value = scalar.constant 42 : i32
    view.store %value, %local_payload[0] : i32, view<1xi32>
    channel.publish %local_write : write<tile<1xi32>>
    %read, %result = channel.acquire %local : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
    %output_view = buffer.view %output[%origin] : buffer -> view<1xi32>
    // ERROR@+1: XDNA/051 {requirement="ordered retirement of DMA paths sharing one core token stream"}
    %outgoing = kernel.async.copy %result to %output_view {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
    %departure = kernel.async.group %outgoing : kernel.async.token -> kernel.async.group
    kernel.async.wait %arrival {newer_groups = 1} : kernel.async.group
    channel.publish %write : write<tile<1xi32>>
    kernel.async.wait %departure {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<1xi32>>
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %read, %payload = channel.acquire %source : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
    %keep, %copy = channel.fanout %read : read<tile<1xi32>> -> (read<tile<1xi32>>, read<tile<1xi32>>)
    %destination_write, %destination_payload = channel.reserve %destination : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    channel.copy %copy -> %destination_write : read<tile<1xi32>>, write<tile<1xi32>>
    channel.release %keep : read<tile<1xi32>>
  }
}
