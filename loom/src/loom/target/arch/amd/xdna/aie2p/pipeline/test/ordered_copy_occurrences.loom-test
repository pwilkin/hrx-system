// ====
// RUN: emit source-low @entry target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// Core-local ingress uses a completion semaphore instead of reply tokens.
// Serial occurrences reuse that credit and both descriptor chains while each
// call still computes and publishes its own result.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def @transform() run(%input: buffer, %output: buffer, %offset: offset) {
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %bytes = index.constant 4 : offset
  %origin = index.constant 0 : offset
  %capacity = index.constant 1 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x1xi32>
  %channel = channel.bind<fifo> %slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %source = buffer.view %input[%offset] : buffer -> view<1xi32>
    %write, %incoming_payload = channel.reserve %channel : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %destination = buffer.view %output[%offset] : buffer -> view<1xi32>
    %incoming = kernel.async.copy %source to %incoming_payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
    %arrival = kernel.async.group %incoming : kernel.async.token -> kernel.async.group
    kernel.async.wait %arrival {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<1xi32>>
    %read, %local = channel.acquire %channel : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
    %value = view.load %local[0] : view<1xi32> -> i32
    %increment = scalar.constant 1 : i32
    %result = scalar.addi %value, %increment : i32
    view.store %result, %local[0] : i32, view<1xi32>
    %outgoing = kernel.async.copy %local to %destination {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
    %departure = kernel.async.group %outgoing : kernel.async.token -> kernel.async.group
    kernel.async.wait %departure {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<1xi32>>
  }
}

pipeline.def<kernel> public retain target(@device) @entry() run(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 4} : buffer, buffer
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %stride = index.constant 8 : offset
  %bytes = index.constant 4 : offset
  pipeline.serial {
    scf.for %pair = [%begin to %end step %step] {
      %first = index.scale %pair, %stride : index, offset -> offset
      %second = index.add %first, %bytes : offset
      pipeline.compose @transform(%input, %output, %first) : (buffer, buffer, offset)
      pipeline.compose @transform(%input, %output, %second) : (buffer, buffer, offset)
    }
  }
}

