// RUN: emit source-low @entry target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// Equal private credits share a physical pair after each child retires.
// The imported parent FIFO stays live and must keep a distinct pair.
pipeline.def @consume_record() run(%input: channel<tile<16xi32>>, %capacity: index) {
  %origin = index.constant 0 : offset
  %record_bytes = index.constant 64 : offset
  %bytes = index.scale %capacity, %record_bytes : index, offset -> offset
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %storage = buffer.alloca<workgroup> pool(%memory) align(64) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<[%capacity]x16xi32>
  %channel = channel.bind<fifo> %slots, %capacity : view<[%capacity]x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %input_read, %source = channel.acquire %input : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    %write, %destination = channel.reserve %channel : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    %value = vector.load %source[0] : view<16xi32> -> vector<16xi32>
    vector.store %value, %destination[0] : vector<16xi32>, view<16xi32>
    channel.publish %write : write<tile<16xi32>>
    channel.release %input_read : read<tile<16xi32>>
    %read, %record = channel.acquire %channel : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    channel.release %read : read<tile<16xi32>>
  }
}

pipeline.def<kernel> public @entry() run() {
  %capacity = index.constant 1 : index
  %origin = index.constant 0 : offset
  %record_bytes = index.constant 64 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %records = index.constant 2 : index
  %second_capacity = index.constant 1 : index
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %storage = buffer.alloca<workgroup> pool(%memory) align(64) %record_bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x16xi32>
  %input = channel.bind<fifo> %slots, %capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %records step %step] {
      %write, %destination = channel.reserve %input : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
      %value = index.cast %record : index to i32
      %values = vector.splat %value : vector<16xi32>
      vector.store %values, %destination[0] : vector<16xi32>, view<16xi32>
      channel.publish %write : write<tile<16xi32>>
    }
  }
  pipeline.serial {
    pipeline.compose @consume_record(%input, %capacity) : (channel<tile<16xi32>>, index)
    pipeline.compose @consume_record(%input, %second_capacity) : (channel<tile<16xi32>>, index)
  }
}

