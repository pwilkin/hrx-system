// RUN: emit source-low @entry target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// Concurrent children share the same physical memory bank through neighboring
// tile apertures, but their payload and semaphore lifetimes remain disjoint.
pipeline.def @round_trip() run(%row: index) {
  %capacity = index.constant 1 : index
  %origin = index.constant 0 : offset
  %record_bytes = index.constant 64 : offset
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %storage = buffer.alloca<workgroup> pool(%memory) align(64) %record_bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x16xi32>
  %channel = channel.bind<fifo> %slots, %capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0, %row], [1, 1], [1, 1]) {
    %write, %destination = channel.reserve %channel : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    %values = vector.splati 37 : vector<16xi32>
    vector.store %values, %destination[0] : vector<16xi32>, view<16xi32>
    channel.publish %write : write<tile<16xi32>>
    %read, %record = channel.acquire %channel : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    channel.release %read : read<tile<16xi32>>
  }
}

pipeline.def @pair() run() {
  %local_row = index.constant 2 : index
  %neighbor_row = index.constant 3 : index
  pipeline.compose @round_trip(%local_row) : (index)
  pipeline.compose @round_trip(%neighbor_row) : (index)
}

pipeline.def<kernel> public @entry() run() {
  pipeline.serial {
    pipeline.compose @pair() : ()
    pipeline.compose @pair() : ()
  }
}

