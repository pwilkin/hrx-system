// =====

// RUN: emit source-low @single_reduction target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=module

// Four compute senders occupy every southbound lane. Input task refill
// borrows an output path whose sole record has its initial receiver credit.
// No subsequent receiver continuation is required for this complete lifetime.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

func.def inline @fifo(%memory: pool, %capacity: index) -> (channel<tile<16xi32>>) {
  %origin = index.constant 0 : offset
  %record_bytes = index.constant 64 : offset
  %bytes = index.scale %capacity, %record_bytes : index, offset -> offset
  %storage = buffer.alloca<workgroup> pool(%memory) align(64) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<[%capacity]x16xi32>
  %result = channel.bind<fifo> %slots, %capacity : view<[%capacity]x16xi32>, index -> channel<tile<16xi32>>
  func.return %result : channel<tile<16xi32>>
}

func.def inline @reduce(%input: channel<tile<16xi32>>, %output: channel<tile<16xi32>>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %cohorts = index.constant 1 : index
  %panels = index.constant 65536 : index
  %initial_sum = vector.splati 0 : vector<16xi32>
  scf.for %cohort = [%begin to %cohorts step %step] {
    %write, %destination = channel.reserve %output : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    %result = scf.for %panel = [%begin to %panels step %step](%sum = %initial_sum : vector<16xi32>) -> (vector<16xi32>) {
      %read, %source = channel.acquire %input : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
      %values = vector.load %source[0] : view<16xi32> -> vector<16xi32>
      %next = vector.addi %sum, %values : vector<16xi32>
      channel.release %read : read<tile<16xi32>>
      scf.yield %next : vector<16xi32>
    }
    vector.store %result, %destination[0] : vector<16xi32>, view<16xi32>
    channel.publish %write : write<tile<16xi32>>
  }
  func.return
}

