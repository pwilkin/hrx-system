// ====
// RUN: with-checks emit aie2p-xdna input=source-low output=pipeline-report

// Each short address period uses the independent descriptor iterator. Repeating
// it across a task chain would duplicate that iterator state, so this source
// retains instruction issue instead of incorrectly repeating its first record.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @period_iterator() run(%input_arg: buffer, %output_arg: buffer) {
