low.func.def public target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_3) abi(array_program) @neighbor_view() asm {
  %36 = constant 1 : reg<aie2p.config.scalar : i64>
  entry %36, @__aie2p_worker_helper_4, @__aie2p_worker_helper_5
  return
}
