// RUN: emit source-low @periodic_refill target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=module

// Repeated immutable panels feed a bounded SRAM ring throughout one resident
// epoch. The shim repeats the complete source period; the arithmetic reader
// replenishes local queues without a communication core or a host restart.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @periodic_refill() run(%input_arg: buffer, %output_arg: buffer) {
  %input_unique, %output_unique = buffer.assume.noalias %input_arg, %output_arg : buffer, buffer
  %input, %output = buffer.assume.alignment %input_unique, %output_unique {minimum_alignment = 64} : buffer, buffer
  %origin = index.constant 0 : offset
  %sram_bytes = index.constant 256 : offset
  %local_bytes = index.constant 128 : offset
  %sram_capacity = index.constant 4 : index
  %local_capacity = index.constant 2 : index
  %records = index.constant 81920 : index
  %period = index.constant 256 : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %record_bytes = index.constant 64 : offset
  %sram_memory = pipeline.memory<workgroup>[0, 1] : pool
  %local_memory = pipeline.memory<workgroup>[0, 2] : pool
  %sram_storage = buffer.alloca<workgroup> pool(%sram_memory) align(64) %sram_bytes : buffer
  %sram_slots = buffer.view %sram_storage[%origin] : buffer -> view<4x16xi32>
  %sram = channel.bind<fifo> %sram_slots, %sram_capacity : view<4x16xi32>, index -> channel<tile<16xi32>>
  %local_storage = buffer.alloca<workgroup> pool(%local_memory) align(64) %local_bytes : buffer
  %local_slots = buffer.view %local_storage[%origin] : buffer -> view<2x16xi32>
  %local = channel.bind<fifo> %local_slots, %local_capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %records step %step] {
      %local_record = index.rem %record, %period : index
      %offset = index.scale %local_record, %record_bytes : index, offset -> offset
      %external = buffer.view %input[%offset] : buffer -> view<16xi32>
      %write, %payload = channel.reserve %sram : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
      %copy = kernel.async.copy %external to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xi32> to view<16xi32> -> kernel.async.token
      %arrival = kernel.async.group %copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %arrival {newer_groups = 0} : kernel.async.group
      channel.publish %write : write<tile<16xi32>>
    }
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %records step %step] {
      %read, %source = channel.acquire %sram : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
      %write, %destination = channel.reserve %local : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
      channel.copy %read -> %write : read<tile<16xi32>>, write<tile<16xi32>>
    }
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %bias = vector.splati 17 : vector<16xi32>
    scf.for %record = [%begin to %records step %step] {
      %read, %payload = channel.acquire<mutable> %local : channel<tile<16xi32>> -> (read<tile<16xi32>, mutable>, view<16xi32>)
      %values = vector.load %payload[0] : view<16xi32> -> vector<16xi32>
      %result = vector.addi %values, %bias : vector<16xi32>
      vector.store %result, %payload[0] : vector<16xi32>, view<16xi32>
      %offset = index.scale %record, %record_bytes : index, offset -> offset
      %external = buffer.view %output[%offset] : buffer -> view<16xi32>
      %copy = kernel.async.copy %payload to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi32> to view<16xi32> -> kernel.async.token
      %departure = kernel.async.group %copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %departure {newer_groups = 0} : kernel.async.group
      channel.release %read : read<tile<16xi32>, mutable>
    }
  }
}


