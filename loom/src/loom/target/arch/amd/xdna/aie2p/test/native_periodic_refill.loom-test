// ====
// RUN: emit source-low @periodic_odd target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=module

// Each period visits all odd-numbered input panels. The source descriptor
// keeps the nonzero base and doubled stride; it must not fetch even panels.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @periodic_odd() run(%input_arg: buffer, %output_arg: buffer) {
  %input_unique, %output_unique = buffer.assume.noalias %input_arg, %output_arg : buffer, buffer
  %input, %output = buffer.assume.alignment %input_unique, %output_unique {minimum_alignment = 64} : buffer, buffer
  %origin = index.constant 0 : offset
  %sram_bytes = index.constant 256 : offset
  %local_bytes = index.constant 128 : offset
  %sram_capacity = index.constant 4 : index
  %local_capacity = index.constant 2 : index
  %records = index.constant 81920 : index
  %panel_step = index.constant 2 : index
  %panel_origin = index.constant 1 : index
  %period = index.constant 256 : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %record_bytes = index.constant 64 : offset
  %sram_memory = pipeline.memory<workgroup>[0, 1] : pool
  %local_memory = pipeline.memory<workgroup>[0, 2] : pool
  %sram_storage = buffer.alloca<workgroup> pool(%sram_memory) align(64) %sram_bytes : buffer
  %sram_slots = buffer.view %sram_storage[%origin] : buffer -> view<4x16xi32>
  %sram = channel.bind<fifo> %sram_slots, %sram_capacity : view<4x16xi32>, index -> channel<tile<16xi32>>
  %local_storage = buffer.alloca<workgroup> pool(%local_memory) align(64) %local_bytes : buffer
  %local_slots = buffer.view %local_storage[%origin] : buffer -> view<2x16xi32>
  %local = channel.bind<fifo> %local_slots, %local_capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %records step %step] {
      %even = index.mul %record, %panel_step : index
      %odd = index.add %even, %panel_origin : index
      %local_record = index.rem %odd, %period : index
      %offset = index.scale %local_record, %record_bytes : index, offset -> offset
      %external = buffer.view %input[%offset] : buffer -> view<16xi32>
      %write, %payload = channel.reserve %sram : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
