// RUN: emit source-low @entry target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// Two sibling producers export their reserved payload before publishing it.
// The second export uses write slot one although there is no read cursor.
// DMA direction therefore cannot select the read/write ownership cursor.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def @process_record() run(%channel: channel<tile<1xi32>>, %input: buffer, %output: buffer, %record: index) {
  %record_bytes = index.constant 4 : offset
  %offset = index.scale %record, %record_bytes : index, offset -> offset
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %source = buffer.view %input[%offset] : buffer -> view<1xi32>
    %write, %incoming = channel.reserve %channel : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %receive = kernel.async.copy %source to %incoming {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
    %receive_group = kernel.async.group %receive : kernel.async.token -> kernel.async.group
    kernel.async.wait %receive_group {newer_groups = 0} : kernel.async.group
    %value = view.load %incoming[0] : view<1xi32> -> i32
    %position = index.cast %record : index to i32
    %bias = scalar.constant 1 : i32
    %adjusted = scalar.addi %value, %position : i32
    %result = scalar.addi %adjusted, %bias : i32
    view.store %result, %incoming[0] : i32, view<1xi32>
    %destination = buffer.view %output[%offset] : buffer -> view<1xi32>
    %send = kernel.async.copy %incoming to %destination {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
    %send_group = kernel.async.group %send : kernel.async.token -> kernel.async.group
    kernel.async.wait %send_group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<1xi32>>
  }
}

pipeline.def<kernel> public retain target(@device) @entry() run(%input_argument: buffer, %output_argument: buffer) {
  %input, %output = buffer.assume.alignment %input_argument, %output_argument {minimum_alignment = 4} : buffer, buffer
  %origin = index.constant 0 : offset
  %storage_bytes = index.constant 8 : offset
  %capacity = index.constant 2 : index
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %storage_bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<2x1xi32>
  %channel = channel.bind<fifo> %slots, %capacity : view<2x1xi32>, index -> channel<tile<1xi32>>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  pipeline.serial {
    pipeline.compose @process_record(%channel, %input, %output, %begin) : (channel<tile<1xi32>>, buffer, buffer, index)
    pipeline.compose @process_record(%channel, %input, %output, %step) : (channel<tile<1xi32>>, buffer, buffer, index)
  }
}

