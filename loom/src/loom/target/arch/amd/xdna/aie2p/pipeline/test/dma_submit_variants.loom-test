// ====

// RUN: emit source-low output=low

// Twenty local addresses exceed the descriptor bank while external offsets
// change by epoch. Fixed variants and the remaining patchable descriptor must
// use separate submission bodies: only the latter writes a local address.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @scatter_epochs() run(%output_arg: buffer) {
  %output = buffer.assume.alignment %output_arg {minimum_alignment = 4} : buffer
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %origin = index.constant 0 : offset
  %bytes = index.constant 80 : offset
  %capacity = index.constant 1 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x20xi32>
  %channel = channel.bind<fifo> %slots, %capacity : view<1x20xi32>, index -> channel<tile<20xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %write, %destination = channel.reserve %channel : channel<tile<20xi32>> -> (write<tile<20xi32>>, view<20xi32>)
    %values = vector.splati 17 : vector<20xi32>
    vector.store %values, %destination[0] : vector<20xi32>, view<20xi32>
    channel.publish %write : write<tile<20xi32>>
    %read, %source = channel.acquire %channel : channel<tile<20xi32>> -> (read<tile<20xi32>>, view<20xi32>)
    %begin = index.constant 0 : index
    %end = index.constant 20 : index
    %step = index.constant 1 : index
    %epochs = index.constant 2 : index
    %word_bytes = index.constant 4 : offset
    scf.for %epoch = [%begin to %epochs step %step] {
      %epoch_offset = index.scale %epoch, %bytes : index, offset -> offset
      scf.for %position = [%begin to %end step %step] unroll {
        %part = view.subview %source[%position] : view<20xi32> -> view<1xi32>
        %local_offset = index.scale %position, %word_bytes : index, offset -> offset
        %offset = index.add %epoch_offset, %local_offset : offset
        %target = buffer.view %output[%offset] : buffer -> view<1xi32>
        %copy = kernel.async.copy %part to %target {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
        %completion = kernel.async.group %copy : kernel.async.token -> kernel.async.group
        kernel.async.wait %completion {newer_groups = 0} : kernel.async.group
      }
    }
    channel.release %read : read<tile<20xi32>>
  }
