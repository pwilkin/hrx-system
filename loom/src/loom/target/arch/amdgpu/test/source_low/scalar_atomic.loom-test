// Each wave publishes its coherent partial before updating a uniform arrival
// counter. The returned scalar ticket completes through LGKM before its use.
// RUN: emit amdgpu-assembly @publish_arrival

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @publish_arrival(%partial: reg<amdgpu.sgpr x2>, %counter: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.vgpr>, %value: reg<amdgpu.vgpr x2>, %limit: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  global_store_dwordx2_saddr %offset, %value, %partial {sc0 = 1, sc1 = 1}
  s_waitcnt {vmcnt = 0, lgkmcnt = 0}
  %ticket = s_atomic_dec_rtn_offset_only %limit, %counter : reg<amdgpu.sgpr>
  %next = s_add_u32_rhs_inline %ticket, 1
  return %next
}

// ----
  global_store_dwordx2 v0, v[2:3], s[0:1] offset:0 sc0 sc1
  s_waitcnt vmcnt(0) lgkmcnt(0)
  s_atomic_dec s2, s[4:5], 0 glc
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_add_u32 s0, s2, 1
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @scalar_atomic_payloads

amdgpu.target<gfx90a> @target

low.func.def target<amdgpu.cdna2.core>(@target) @scalar_atomic_payloads(%base: reg<amdgpu.sgpr x2>, %resource: reg<amdgpu.sgpr x4>, %offset: reg<amdgpu.sgpr>, %pair: reg<amdgpu.sgpr x4>, %limit: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x4>) asm {
  s_atomic_inc_x2 %limit, %base, %offset {offset = -1048576}
  %old = s_buffer_atomic_cmpswap_x2_rtn %pair, %resource, %offset {offset = 1048568} : reg<amdgpu.sgpr x4>
  return %old
}

// ----
  s_atomic_inc_x2 s[2:3], s[0:1], s12 offset:-1048576
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_buffer_atomic_cmpswap_x2 s[4:7], s[8:11], s12 offset:1048568 glc
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

// ====
// RUN: emit amdgpu-native-words @scalar_atomic_packets

amdgpu.target<gfx950> @target

low.func.def target<amdgpu.cdna4.core>(@target) @scalar_atomic_packets(%base: reg<amdgpu.sgpr x2>, %resource: reg<amdgpu.sgpr x4>, %offset: reg<amdgpu.sgpr>, %value: reg<amdgpu.sgpr>, %pair: reg<amdgpu.sgpr x2>) asm {
  s_atomic_xor %value, %base, %offset {offset = -16}
  s_buffer_atomic_inc_offset_only %value, %resource {offset = 12}
  %old = s_atomic_cmpswap_rtn_offset_only %pair, %base {offset = 4} : reg<amdgpu.sgpr x2>
  return
}

