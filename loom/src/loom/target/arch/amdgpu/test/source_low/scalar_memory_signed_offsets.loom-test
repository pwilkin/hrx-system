// Uniform row addressing crosses the positive immediate range. The excess
// stays in SOFFSET rather than becoming a negative native immediate.
// RUN: emit source-low target=amdgpu:gfx942 output=low

kernel.def @uniform_row_at_two_megabytes() {
  %groups = index.constant 2 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %group = kernel.workgroup.id<x> : index
  %stride = index.constant 2048 : offset
  %origin = index.constant 2097152 : offset
  %relative = index.scale %group, %stride : index, offset -> offset
  %address = index.add %origin, %relative : offset
  %constant_input = buffer.assume.memory_space<constant> %input : buffer
  %source = buffer.view %constant_input[%address] : buffer -> view<4xi32>
  %value = vector.load %source[0] : view<4xi32> -> vector<4xi32>
  %output_stride = index.constant 16 : offset
  %output_origin = index.scale %group, %output_stride : index, offset -> offset
  %destination = buffer.view %output[%output_origin] : buffer -> view<4xi32>
  vector.store %value, %destination[0] : vector<4xi32>, view<4xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(2, 1, 1) @uniform_row_at_two_megabytes() asm {
  %group = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %20 = s_lshl_b32_rhs_inline %group, 11
  %21 = s_mov_b32 1048580
  %22 = s_add_u32 %20, %21
  %value = s_load_dwordx4 %source, %22 {offset = 1048572}
  %26 = slice %value[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %27 = v_mov_b32_copy %26
  %28 = slice %value[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %29 = v_mov_b32_copy %28
  %30 = slice %value[2] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %31 = v_mov_b32_copy %30
  %32 = slice %value[3] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %33 = v_mov_b32_copy %32
  %34 = concat(%27, %29, %31, %33) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %35 = v_mov_b32 0
  %36 = s_lshl_b32_rhs_inline %group, 4
  %37 = slice %destination[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %38 = slice %destination[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %39 = s_mov_b32 0
  %40, %41 = s_add_co_u32 %37, %36
  %42, %43 = s_addc_u32 %38, %39, %41
  %44 = concat(%40, %42) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_dwordx4_saddr %35, %34, %44
  return
}

