// ====
// RUN: emit amdgpu-assembly @signed_scalar_offsets_cdna

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @signed_scalar_offsets_cdna(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %negative = s_load_dword %base, %offset {offset = -1048576}
  %positive = s_load_dword %base, %offset {offset = 1048572}
  return %negative, %positive
}

// ----
  s_load_dword s3, s[0:1], s2 offset:-1048576
  s_load_dword s4, s[0:1], s2 offset:1048572
  s_waitcnt vmcnt(63) lgkmcnt(0)
  s_endpgm

// ====
// RUN: emit amdgpu-assembly @signed_scalar_offsets_rdna

amdgpu.target<gfx1200> @target

low.func.def target<amdgpu.rdna4.core>(@target) @signed_scalar_offsets_rdna(%base: reg<amdgpu.sgpr x2>, %offset: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %negative = s_load_dword %base, %offset {offset = -8388608}
  %positive = s_load_dword %base, %offset {offset = 8388604}
  return %negative, %positive
}

// ----
  s_load_dword s3, s[0:1], s2 offset:-8388608
  s_load_dword s4, s[0:1], s2 offset:8388604
  s_wait_kmcnt kmcnt(0)
  s_endpgm

// ====
// RUN: emit source-low target=amdgpu:gfx942 output=low

// A byte-granular field bias joins the dynamic offset before SMEM rounds its
// address components. The typed load requires their complete sum to align.
kernel.def @uniform_biased_byte_offset() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %byte_origin: i32) {
  %bounded = scalar.assume %byte_origin [range(%byte_origin, 0, 1024)] : i32
  %origin = index.cast %bounded : i32 to offset
  %bias = index.constant 1 : offset
  %address = index.add %origin, %bias : offset
  %constant_input = buffer.assume.memory_space<constant> %input : buffer
  %source = buffer.view %constant_input[%address] : buffer -> view<1xi32>
  %value = view.load %source[0] : view<1xi32> -> i32
  %c0 = index.constant 0 : offset
  %destination = buffer.view %output[%c0] : buffer -> view<1xi32>
  view.store %value, %destination[0] : i32, view<1xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 1, direct_arg_count = 1, direct_arg_names = {arg0 = "byte_origin"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_sizes = [4], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @uniform_biased_byte_offset(%origin: reg<amdgpu.sgpr>) asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = s_mov_b32 1
  %17 = s_add_u32 %origin, %16
  %value = s_load_dword %source, %17
  %19 = v_mov_b32_copy %value
  %20 = v_mov_b32 0
  global_store_dword_saddr %20, %19, %destination
  return
}

// ====
// Split scalar packets retain one aligned address when saturating the signed
// immediate range. The two-word and one-word packets share the same SOFFSET.
// RUN: emit source-low target=amdgpu:gfx942 output=low

kernel.def @shared_scalar_packets_above_immediate_range() {
  %groups = index.constant 2 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %group = kernel.workgroup.id<x> : index
  %stride = index.constant 2048 : offset
  %origin = index.constant 2097152 : offset
  %relative = index.scale %group, %stride : index, offset -> offset
  %address = index.add %origin, %relative : offset
  %constant_input = buffer.assume.memory_space<constant> %input : buffer
  %source = buffer.view %constant_input[%address] : buffer -> view<3xi32>
  %value = vector.load %source[0] : view<3xi32> -> vector<3xi32>
  %output_stride = index.constant 12 : offset
  %output_origin = index.scale %group, %output_stride : index, offset -> offset
  %destination = buffer.view %output[%output_origin] : buffer -> view<3xi32>
  vector.store %value, %destination[0] : vector<3xi32>, view<3xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(2, 1, 1) @shared_scalar_packets_above_immediate_range() asm {
  %group = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %20 = s_lshl_b32_rhs_inline %group, 11
  %21 = s_mov_b32 1048588
  %22 = s_add_u32 %20, %21
  %23 = s_load_dwordx2 %source, %22 {offset = 1048564}
  %24 = s_load_dword %source, %22 {offset = 1048572}
  %46 = slice %23[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %29 = v_mov_b32_copy %46
  %45 = slice %23[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %31 = v_mov_b32_copy %45
  %33 = v_mov_b32_copy %24
  %34 = concat(%29, %31, %33) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x3>
  %35 = v_mov_b32 0
  %36 = s_mul_i32_rhs_inline %group, 12
  %37 = slice %destination[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %38 = slice %destination[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %39 = s_mov_b32 0
  %40, %41 = s_add_co_u32 %37, %36
  %42, %43 = s_addc_u32 %38, %39, %41
  %44 = concat(%40, %42) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  global_store_dwordx3_saddr %35, %34, %44
  return
}
